# ENERMAX CRM — PRODUCTION CONFIGURATION TEMPLATE
# Copy to .env.production and provide production secrets

APP_NAME="Enermax CRM"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Security Secrets (Must be at least 32 characters, cryptographically random)
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGEME_REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (Comma-separated list or JSON array of authorized domains)
CORS_ORIGINS=["https://crm.enermaxsolar.com"]

# PostgreSQL Authoritative Database
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=enermax_prod_user
POSTGRES_PASSWORD=CHANGEME_SECURE_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=enermax_crm_prod
DATABASE_URL=postgresql+asyncpg://enermax_prod_user:CHANGEME_SECURE_STRONG_POSTGRES_PASSWORD@postgres:5432/enermax_crm_prod

# Connection Pool & Timeouts
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT=15000
DB_IDLE_TIMEOUT=30000

# Redis Distributed Cache & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD
REDIS_DB=0
REDIS_URL=redis://:CHANGEME_REDIS_PASSWORD@redis:6379/0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=50

# Rate Limiting Parameters
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300

# Security Blacklist
TOKEN_BLACKLIST_ENABLED=true

# Document Storage (Local or S3)
STORAGE_BACKEND=s3
STORAGE_MAX_FILE_SIZE_BYTES=26214400
S3_BUCKET_NAME=enermax-crm-documents-prod
S3_ENDPOINT_URL=
S3_ACCESS_KEY=CHANGEME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGEME_S3_SECRET_KEY
S3_REGION=ap-south-1
