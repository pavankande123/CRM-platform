# ==============================================================================
# ENERMAX CRM - Environment Configuration Template
# NOTE: Copy this file to .env and adjust values for your local environment.
# NEVER commit actual secrets or production credentials to version control.
# ==============================================================================

# Application & Environment
APP_NAME=Enermax CRM
APP_ENV=development # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-in-production
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=enermax_user
POSTGRES_PASSWORD=enermax_secure_password
POSTGRES_DB=enermax_crm
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
# For local dev / SQLite fallback if Postgres is not running:
# DATABASE_URL=sqlite+aiosqlite:///./enermax_dev.db

# Redis Configuration (Cache & Session)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Superadmin Seed Configuration (Initial setup only)
INITIAL_SUPERADMIN_EMAIL=admin@enermax.com
INITIAL_SUPERADMIN_PASSWORD=EnermaxAdminSecure2026!
INITIAL_ORG_NAME=Enermax Systems India
